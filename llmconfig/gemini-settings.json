{
  "allowNonWorkspaceAccess": false,
  "enableTerminalSandbox": true,
  "toolPermission": "proceed-in-sandbox",
  "artifactReviewPolicy": "always-proceed",
  "trustedWorkspaces": ["/home/alex/tmp/"],
  "permissions": {
    "allow": [
      "command(git status)",
      "command(git log)",
      "command(git diff)",
      "command(git show)",
      "command(git fetch)",
      "command(git add)",
      "command(git commit)",
      "command(git stash)",
      "command(ls)",
      "command(cat)",
      "command(head)",
      "command(tail)",
      "command(grep)",
      "command(rg)",
      "command(wc)",
      "command(pwd)",
      "command(which)",
      "command(npm install)",
      "command(npm run build)",
      "command(npm test)",
      "command(pip install)",
      "command(cargo build)",
      "command(cargo test)",
      "command(make test)"
    ],
    "deny": [
      "command(rm -rf)",
      "command(git push --force)",
      "command(git reset --hard)",
      "command(git clean)",
      "command(sudo)",
      "command(chmod -R)",
      "command(dd)",
      "command(mkfs)"
    ]
  },
  "model": "Gemini 4 Argon (Medium)",
  "verbosity": "high",
  "editor": "auto",
  "colorScheme": "dark",
  "altScreenMode": "never",
  "showTips": false,
  "showFeedbackSurvey": false,
  "statusLine": {
    "type": "",
    "command": "",
    "enabled": true
  },
  "navigation.down": ["down", "j"],
  "navigation.left": ["left", "h"],
  "navigation.right": ["right", "l"],
  "navigation.up": ["up", "k"],
  "cli.clear_screen": ["ctrl+l"],
  "prompt.insert_newline": ["shift+enter", "ctrl+j"]
}
