## ================= Functions =================
#-- mandoc
function man {
  command man "$@" | col -bx | bat -l man -p
}
#-- open neovim inside or outside tmux
function v {
  if [ -n "$TMUX" ]; then
    nvim "$@"
  else
    tmux new-session -A -s edit nvim "$@"
  fi
}

#-- lazygit widget (ctrl+g)
function lazygit_widget {
  lazygit
  zle reset-prompt
}
zle -N lazygit_widget
bindkey '^g' lazygit_widget

#-- yazi file manager with cwd sync
function y() {
  (command trash-empty 15 &>/dev/null &)
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
  command yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd <"$tmp"
  [ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
  command rm -f -- "$tmp"
}

## ================= tmux =================
#-- tmux session attach or create
function tm {
  if [ -z "$1" ]; then
    tmux attach || tmux new-session
  else
    tmux attach -t "$1" || tmux new-session -s "$1"
  fi
}
#-- tmux recovery
tmre() {
  if ! tmux has-session 2>/dev/null; then
    tmux new-session -d -s _temp_init 2>/dev/null
    tmux run-shell ~/.tmux/plugins/tmux-resurrect/scripts/restore.sh
    tmux kill-session -t _temp_init 2>/dev/null
  fi
  tmux attach-session
}
