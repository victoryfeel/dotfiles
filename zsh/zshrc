## ================= FZF Search Widgets =================
#-- search directory (ctrl+j)
fzf-work-cd() {
  local dir=$(fd --type d --hidden --exclude .git . ~/alexmak/ | fzf --height 40% --reverse)
  if [ -n "$dir" ]; then
    zle -I
    cd "$dir"
    ls -alh
  fi
  zle reset-prompt
}
zle -N fzf-work-cd
bindkey '^j' fzf-work-cd

#-- search file and edit (ctrl+k)
fzf-work-edit() {
  local file=$(fd --type f --hidden --exclude .git . ~/alexmak/ | fzf --height 40% --reverse)
  if [ -n "$file" ]; then
    zle -I
    cd "$(dirname "$file")"
    nvim "$file"
  fi
  zle reset-prompt
}
zle -N fzf-work-edit
bindkey '^k' fzf-work-edit

#-- search content with ripgrep (ctrl+l)
fzf-work-search-content() {
  local selected=$(rg --line-number --no-heading --smart-case --hidden --glob '!.git' . ~/alexmak/ 2>/dev/null | fzf --height 40% --reverse)
  if [ -n "$selected" ]; then
    local file=$(echo "$selected" | cut -d: -f1)
    local line=$(echo "$selected" | cut -d: -f2)
    zle -I
    cd "$(dirname "$file")"
    nvim "+${line}" "$file"
  fi
  zle reset-prompt
}
zle -N fzf-work-search-content
bindkey '^l' fzf-work-search-content

## ================= Vim Mode =================
#-- enable vi mode
bindkey -v

#-- history navigation (j/k)
bindkey -M vicmd 'k' history-substring-search-up
bindkey -M vicmd 'j' history-substring-search-down

#-- line movement (H/L)
bindkey -M vicmd 'H' vi-first-non-blank
bindkey -M vicmd 'L' vi-end-of-line

#-- edit command line in neovim (ctrl+e)
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey -M viins '^e' edit-command-line
bindkey -M vicmd '^e' edit-command-line

#-- cursor shape indicator
function zle-keymap-select {
  if [[ $KEYMAP == vicmd ]]; then
    echo -ne '\e[2 q' # Block
  else
    echo -ne '\e[6 q' # Beam
  fi
}
zle -N zle-keymap-select
[[ -z "$NVIM" ]] && echo -ne '\e[6 q'

#-- multi-key timeout
KEYTIMEOUT=1
