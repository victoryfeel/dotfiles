{
  "Table": {
    "prefix": "tbl",
    "body": [
      "| <++> | <++> | <++> |",
      "| :--- | :---: | ---: |",
      "| <++> | <++> | <++> |",
      "<++>"
    ]
  },
  "GitHub Callout Note": {
    "prefix": "note",
    "body": ["> [!NOTE]", "> <++>"]
  },
  "GitHub Callout Important": {
    "prefix": "tip",
    "body": ["> [!IMPORTANT]", "> <++>"]
  },
  "Fenced Code Block": {
    "prefix": "cb",
    "body": ["```<++>", "<++>", "```"]
  },
  "LaTeX Math Display Block": {
    "prefix": "mathb",
    "body": ["$$", "<++>", "$$", "<++>"]
  },
  "Subpage Link": {
    "prefix": "subpath",
    "body": ["[<++>](../assets/subpage/<++>.md)"]
  }
}
