{
  "C++20 Backend Service Clang-Format Style": {
    "prefix": ["cfm"],
    "body": [
      "---",
      "# ============================================================",
      "#  C++20 Backend Service Style Guide (Optimized)",
      "#  Base: LLVM",
      "# ============================================================",
      "",
      "Language: Cpp",
      "BasedOnStyle: LLVM",
      "Standard: c++20",
      "",
      "# ============================================================",
      "",
      "# 1. Global Layout",
      "# ============================================================",
      "",
      "InsertNewlineAtEOF: true",
      "IndentWidth: 2",
      "TabWidth: 2",
      "UseTab: Never",
      "ColumnLimit: 100",
      "MaxEmptyLinesToKeep: 2",
      "SpacesBeforeTrailingComments: 2",
      "IndentPPDirectives: AfterHash",
      "",
      "# ============================================================",
      "# 2. Pointer & Reference Style",
      "# ============================================================",
      "",
      "PointerAlignment: Left",
      "ReferenceAlignment: Pointer",
      "",
      "# ============================================================",
      "# 3. Brace & Block Wrapping",
      "# ============================================================",
      "",
      "BreakBeforeBraces: Attach",
      "# 自动为单行控制语句补全花括号（防 Bug 神器，若历史代码包袱重可设为 false）",
      "InsertBraces: true",
      "",
      "# ============================================================",
      "# 4. Control, Lambda & Function Layout",
      "# ============================================================",
      "",
      "AllowShortFunctionsOnASingleLine: Empty",
      "AllowShortIfStatementsOnASingleLine: Never",
      "AllowShortLoopsOnASingleLine: false",
      "AllowShortEnumsOnASingleLine: false",
      "AllowShortLambdasOnASingleLine: Inline",
      "",
      "# 避免多行 Lambda 在 BlockIndent 模式下缩进过深",
      "LambdaBodyIndentation: Signature",
      "",
      "SpacesInAngles: false",
      "BreakTemplateDeclarations: Yes",
      "BreakBeforeConceptDeclarations: true",
      "",
      "BinPackParameters: false",
      "BinPackArguments: false",
      "",
      "# Function parameters & Continuation",
      "AlignAfterOpenBracket: BlockIndent",
      "ContinuationIndentWidth: 4",
      "AllowAllArgumentsOnNextLine: true",
      "AllowAllParametersOfDeclarationOnNextLine: true",
      "",
      "# 现代版构造函数初始化列表配置",
      "PackConstructorInitializers: NextLineOnly",
      "BreakConstructorInitializers: BeforeComma",
      "",
      "SpaceBeforeParens: ControlStatements",
      "BreakAfterReturnType: None",
      "",
      "# C++20 Requires & Concepts",
      "",
      "RequiresClausePosition: OwnLine",
      "IndentRequiresClause: true",
      "RequiresExpressionIndentation: Keyword",
      "",
      "# ============================================================",
      "# 5. Include Management Policy",
      "# ============================================================",
      "",
      "SortIncludes: CaseSensitive",
      "IncludeBlocks: Regroup",
      "",
      "IncludeCategories:",
      "  # C system & POSIX headers (<stdint.h>, <sys/epoll.h>)",
      "  - Regex: '^<([a-zA-Z0-9_-]+/)?[a-zA-Z0-9_-]+\\.h>'",
      "    Priority: 1",
      "  # C++ Standard Library (<iostream>, <coroutine>, <ranges>, <span >)",
      "  - Regex: '^<(experimental/)?[a-zA-Z0-9_-]+>'",
      "    Priority: 2",
      "  # Testing frameworks",
      "  - Regex: '^<(gtest|gmock)/.*>'",
      "    Priority: 3",
      "  # Third-party libraries (<boost/...>, <fmt/...>, <spdlog/...>)",
      "  - Regex: '^<.*>'",
      "    Priority: 4",
      "  # Project public headers",
      "  - Regex: '^\"public/.*'",
      "    Priority: 5",
      "  # Project internal headers",
      "  - Regex: '.*'",
      "    Priority: 6",
      "",
      "# ============================================================",
      "# 6. Namespace Rules",
      "",
      "# ============================================================",
      "",
      "NamespaceIndentation: None",
      "FixNamespaceComments: true",
      ""
    ],
    "description": "C++20 Backend Service Clang-Format Style Guide"
  }
}
