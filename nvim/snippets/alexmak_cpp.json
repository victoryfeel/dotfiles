{
  "Doxygen Function Comment": {
    "prefix": "addinfo",
    "body": [
      "/**",
      " * @brief",
      " *   ${1:Brief description.}",
      " * @details",
      " *   ${2:Detailed description.}",
      " *",
      " * @usage",
      " *   ${3:Usage description.}",
      " * @return",
      " *   ${4:Type and description of the returned value.}",
      " * @author Alex Mak (aliasgmail@duck.com)",
      " */",
      "$0"
    ],
    "description": "A C++ comment block for functions, including brief, details, usage, return, and author."
  },
  "Disallow Copy and Assign": {
    "prefix": "nocopy",
    "body": [
      "${1:ClassName}(const ${1:ClassName}&) = delete;",
      "${1:ClassName}& operator=(const ${1:ClassName}&) = delete;",
      "${1:ClassName}(${1:ClassName}&&) = delete;",
      "${1:ClassName}& operator=(${1:ClassName}&&) = delete;"
    ],
    "description": "Disable copy/move constructors and assignment operators"
  },
  "Thread-Safe Singleton (Meyers)": {
    "prefix": "singleton",
    "body": [
      "class ${1:Singleton} {",
      "public:",
      "    static ${1:Singleton}& GetInstance() {",
      "        static ${1:Singleton} instance;",
      "        return instance;",
      "    }",
      "",
      "    ${1:Singleton}(const ${1:Singleton}&) = delete;",
      "    ${1:Singleton}& operator=(const ${1:Singleton}&) = delete;",
      "    ${1:Singleton}(${1:Singleton}&&) = delete;",
      "    ${1:Singleton}& operator=(${1:Singleton}&&) = delete;",
      "",
      "private:",
      "    ${1:Singleton}() = default;",
      "    ~${1:Singleton}() = default;",
      "};"
    ],
    "description": "Thread-safe Meyers Singleton pattern"
  },
  "Pimpl Pattern": {
    "prefix": "pimpl",
    "body": [
      "class ${1:MyClass} {",
      "public:",
      "    ${1:MyClass}();",
      "    ~${1:MyClass}();",
      "    ${1:MyClass}(${1:MyClass}&&) noexcept;",
      "    ${1:MyClass}& operator=(${1:MyClass}&&) noexcept;",
      "",
      "    void ${2:DoWork}();",
      "",
      "private:",
      "    struct Impl;",
      "    std::unique_ptr<Impl> impl_;",
      "};"
    ],
    "description": "Pimpl (Pointer to Implementation) pattern header"
  }
}
