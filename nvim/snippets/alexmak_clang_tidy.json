{
  "C++20 Backend Service Clang-Tidy Configuration": {
    "prefix": ["ctd"],
    "body": [
      "---",
      "# ============================================================",
      "#  C++20 Backend Service .clang-tidy Configuration",
      "# ============================================================",
      "",
      "Checks: >",
      "  -*,",
      "  bugprone-*,",
      "  -bugprone-EasilySwappableParameters,",
      "  -bugprone-narrowing-conversions,",
      "  concurrency-*,",
      "  cppcoreguidelines-*,",
      "  -cppcoreguidelines-avoid-magic-numbers,",
      "",
      "  -cppcoreguidelines-pro-type-reinterpret-cast,",
      "  -cppcoreguidelines-pro-bounds-pointer-arithmetic,",
      "",
      "  -cppcoreguidelines-pro-type-vararg,",
      "  -cppcoreguidelines-owning-memory,",
      "  -cppcoreguidelines-non-private-member-variables-in-classes,",
      "  modernize-*,",
      "  -modernize-use-trailing-return-type,",
      "  -modernize-avoid-c-arrays,",
      "",
      "  performance-*,",
      "  readability-*,",
      "  -readability-magic-numbers,",
      "  -readability-identifier-length,",
      "  -readability-function-cognitive-complexity,",
      "  -readability-else-after-return,",
      "  misc-*,",
      "  -misc-non-private-member-variables-in-classes,",
      "  -misc-include-cleaner",
      "",
      "# 将关键的高危隐患直接升级为编译错误（阻断 CI）",
      "WarningsAsErrors: >",
      "  bugprone-use-after-move,",
      "  bugprone-dangling-handle,",
      "  bugprone-string-constructor,",
      "  concurrency-*,",
      "  cppcoreguidelines-missing-std-forward,",
      "  cppcoreguidelines-rvalue-reference-param-not-moved,",
      "  performance-for-range-copy,",
      "  performance-unnecessary-value-param,",
      "  performance-move-const-arg,",
      "  performance-no-automatic-move",
      "",
      "# 仅检查项目自身头文件（过滤 build/、third_party/ 等外部路径）",
      "HeaderFilterRegex: '^(include|src|public)/.*'",
      "FormatStyle: file",
      "UseColor: true",
      "",
      "# ============================================================ ",
      "# 2. 命名规范与细节参数微调 (适配 Google/LLVM 混合后端风格)",
      "# ============================================================",
      "",
      "CheckOptions:",
      "  # --- 性能与现代 C++ 参数 ---",
      "  # 针对 std::vector 等容器预分配检查",
      "  - key: performance-inefficient-vector-operation.EnableProto",
      "    value: true",
      "  # 允许在特定宏内部忽略部分现代改写提示",
      "  - key: modernize-use-nullptr.NullMacros",
      "    value: 'NULL'",
      "  # 结构体如果全都是 public 成员变量（如 DTO/配置项），允许不加 private",
      "  - key: cppcoreguidelines-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic",
      "    value: true",
      "",
      "  # --- 标识符命名规范检查 (可根据团队习惯微调) ---",
      "  # 类、结构体、Concept、枚举名：大驼峰 (MyService)",
      "  - key: readability-identifier-naming.ClassCase",
      "    value: CamelCase",
      "  - key: readability-identifier-naming.StructCase",
      "    value: CamelCase",
      "  - key: readability-identifier-naming.EnumCase",
      "    value: CamelCase",
      "",
      "  # 函数与方法名：大驼峰或小驼峰 (这里设为 CamelCase，若习惯 snake_case 可改用 lower_case)",
      "  - key: readability-identifier-naming.FunctionCase",
      "    value: camelBack",
      "",
      "  # 局部变量与参数：snake_case (client_fd)",
      "  - key: readability-identifier-naming.VariableCase",
      "    value: lower_case",
      "  - key: readability-identifier-naming.ParameterCase",
      "    value: lower_case",
      "",
      "  # 类的私有/保护成员变量：snake_case 带下划线后缀 (epoll_fd_)",
      "  - key: readability-identifier-naming.PrivateMemberCase",
      "    value: lower_case",
      "  - key: readability-identifier-naming.PrivateMemberSuffix",
      "    value: '_'",
      "  - key: readability-identifier-naming.ProtectedMemberCase",
      "    value: lower_case",
      "  - key: readability-identifier-naming.ProtectedMemberSuffix",
      "    value: '_'",
      "",
      "  # 常量与枚举值：k 开头大驼峰 (kMaxEvents) 或全大写 (MAX_EVENTS)",
      "  - key: readability-identifier-naming.ConstantCase",
      "    value: CamelCase",
      "  - key: readability-identifier-naming.ConstantPrefix",
      "    value: 'k'",
      "  - key: readability-identifier-naming.EnumConstantCase",
      "    value: CamelCase",
      "  - key: readability-identifier-naming.EnumConstantPrefix",
      "    value: 'k'",
      "",
      "  # 宏定义：全大写下划线 (ENABLE_COROUTINE)",
      "  - key: readability-identifier-naming.MacroDefinitionCase",
      "    value: UPPER_CASE",
      ""
    ],
    "description": "C++20 Backend Service Clang-Tidy Configuration"
  }
}
