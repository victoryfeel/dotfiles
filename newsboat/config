##===========================##
##========  GENERAL  ========##
##===========================##
datetime-format     "%m/%d/%y"
feedlist-format     "%4i %3U %t"
articlelist-format  "%4i %f %D %?T?|%-17T|  ?%t"
show-read-feeds     no
show-read-articles  no
cleanup-on-quit     no
pager internal
confirm-mark-feed-read no
# show-keymap-hint no
# show-titile-bar no
auto-reload         yes
reload-time 30
reload-threads 256
max-items 95

#browser "open '%u'"
browser "${HOME}/.config/scripts/browser-in-host.sh '%u'"


##===========================##
##========  KEYMAP  =========##
##===========================##

#-- navigate --#
unbind-key R
unbind-key j
unbind-key k
unbind-key J
unbind-key K
unbind-key C
unbind-key ,
unbind-key v
unbind-key T

bind SPACE everywhere macro-prefix
bind q everywhere quit
bind Q everywhere hard-quit
bind U everywhere toggle-show-read-feeds
bind j everywhere down
bind k everywhere up
bind g everywhere home
bind G everywhere end
bind J articlelist next-feed
bind K articlelist next-feed
bind l everywhere open
bind h articlelist quit
bind h article quit
bind J article next
bind K article next
bind R everywhere reload-all
bind o everywhere open-in-browser-and-mark-read
bind m everywhere toggle-article-read
bind M everywhere mark-feed-read
bind T everywhere toggle-show-read-feeds ; set show-read-articles!
# bind A everywhere mark-all-feeds-read



##==========================##
##========  THEMES  ========##
##==========================##
color listnormal color255 default
color listfocus color238 color255 standout
color listnormal_unread color47 default
color listfocus_unread color238 color47 standout
color info color141 color236
#-- highlights --#
highlight all "---.*---" yellow
highlight feedlist ".*(0/0))" black
highlight article "(^Feed:|^Title:|^Date:|^Link:|^Author:)" cyan default bold
highlight article "https?://[^ ]+" yellow default
highlight article "\\[[0-9][0-9]*\\]" magenta default bold
highlight article "\\[image\\ [0-9]+\\]" green default bold
highlight article "\\[embedded flash: [0-9][0-9]*\\]" green default bold
highlight article ":.*\\(link\\)$" cyan default
highlight article ":.*\\(image\\)$" blue default
highlight article ":.*\\(embedded flash\\)$" magenta default


##===========================##
##========  IGNORES  ========##
##===========================##
ignore-article "https://daringfireball.net/feeds/main" "title =~ \"\\[Sponsor\\]\""
ignore-article "https://jiteshcodes.com/index.xml" "title =~ \"Sponsor\""
